					r3.w = mad(r0.w, r2.y, -(r6.w));
					// sincos null, r3.w, r3.w
					r3.w = cos(r3.w);
					// add r1.w, r1.w, r3.w
					r1.w = r1.w + r3.w;
					// mul r2.xy, r2.ywyy, r2.xxxx
					r2.xy = float2(r2.y * r2.x, r2.w * r2.x);
					// mad r2.x, r2.x, l(0.600000), r6.w
					r2.x = mad(r2.x, 0.6, r6.w);
					// sincos r2.x, null, r2.x
					r2.x = sin(r2.x);
					// add r0.x, r0.x, r2.x
					r0.x = r0.x + r2.x;
					// mad r2.x, cb1[0].y, cb0[6].z, l(5.550000)
					r2.x = mad(_Time.y, _Params.z, 5.55);
					// mad r3.w, r0.z, r2.w, r2.x
					r3.w = mad(r0.z, r2.w, r2.x);
					// sincos r3.w, null, r3.w
					r3.w = sin(r3.w);
					// add r4.x, r1.z, r3.w
					r4.x = r1.z + r3.w;
					// mad r1.z, r0.w, r2.w, -r2.x
					r1.z = mad(r0.w, r2.w, -(r2.x));
					// sincos null, r1.z, r1.z
					r1.z = cos(r1.z);
					// add r4.y, r1.z, r1.w
					r4.y = r1.z + r1.w;
					// mad r1.z, r2.y, l(0.600000), r2.x
					r1.z = mad(r2.y, 0.6, r2.x);
					// sincos r1.z, null, r1.z
					r1.z = sin(r1.z);
					// add r4.z, r0.x, r1.z
					r4.z = r0.x + r1.z;
					// mad_sat r2.xyw, r4.xyxz, l(0.160000, 0.160000, 0.000000, 0.160000), l(0.500000, 0.500000, 0.000000, 0.500000)
					r2.xyw = float3(saturate(mad(r4.x, 0.16, 0.5)), saturate(mad(r4.y, 0.16, 0.5)), saturate(mad(r4.z, 0.16, 0.5)));
					// else
				} else {
					// mul r4.xyz, r0.zwzz, cb0[8].xxxx
					r4.xyz = float3(r0.z * _Params3.x, r0.w * _Params3.x, r0.z * _Params3.x);
					// frc r2.xyw, r4.xyxz
					r2.xyw = float3(frac(r4.x), frac(r4.y), frac(r4.z));
				// endif
				}
				// mad r0.x, r1.x, l(0.750000), l(0.550000)
				r0.x = mad(r1.x, 0.75, 0.55);
				// mul_sat r0.x, r0.x, r1.y
				r0.x = saturate(r0.x * r1.y);
				// mul r0.x, r0.x, v2.w
				r0.x = r0.x * v2.w;
				// mul r0.x, r0.y, r0.x
				r0.x = r0.y * r0.x;
				// lt r0.y, r0.x, cb0[9].w
				r0.y = (r0.x < _Threshold) ? -1.0 : 0.0;
				// discard_nz r0.y
				if (any(r0.y)) discard;
				// mad r1.xyz, r3.xyzx, l(0.900000, 0.900000, 0.900000, 0.000000), l(0.600000, 0.600000, 0.600000, 0.000000)
				r1.xyz = float3(mad(r3.x, 0.9, 0.6), mad(r3.y, 0.9, 0.6), mad(r3.z, 0.9, 0.6));
				// mad r1.xyz, r2.xywx, r1.xyzx, -r2.xywx
				r1.xyz = float3(mad(r2.x, r1.x, -(r2.x)), mad(r2.y, r1.y, -(r2.y)), mad(r2.w, r1.z, -(r2.w)));
				// mad r1.xyz, r1.xyzx, l(0.550000, 0.550000, 0.550000, 0.000000), r2.xywx
				r1.xyz = float3(mad(r1.x, 0.55, r2.x), mad(r1.y, 0.55, r2.y), mad(r1.z, 0.55, r2.w));
				// mul r2.xyz, r2.zzzz, cb0[5].xyzx
				r2.xyz = float3(r2.z * _ColorC.x, r2.z * _ColorC.y, r2.z * _ColorC.z);
				// mad r1.xyz, r2.xyzx, l(0.350000, 0.350000, 0.350000, 0.000000), r1.xyzx
				r1.xyz = float3(mad(r2.x, 0.35, r1.x), mad(r2.y, 0.35, r1.y), mad(r2.z, 0.35, r1.z));
				// mul r2.xy, r3.xyxx, l(0.050000, 0.050000, 0.000000, 0.000000)
				r2.xy = float2(r3.x * 0.05, r3.y * 0.05);
				// mad r2.xy, r0.zwzz, l(0.500000, 0.500000, 0.000000, 0.000000), r2.xyxx
				r2.xy = float2(mad(r0.z, 0.5, r2.x), mad(r0.w, 0.5, r2.y));
				// sample r2.xyzw, r2.xyxx, t3.xyzw, s0
				r2.xyzw = tex2D(_MainTex, float2(r2.x, r2.y));
				// mul r2.xyz, r1.xyzx, r2.xyzx
				r2.xyz = float3(r1.x * r2.x, r1.y * r2.y, r1.z * r2.z);
				// mad r2.xyz, r2.xyzx, l(1.500000, 1.500000, 1.500000, 0.000000), -r1.xyzx
				r2.xyz = float3(mad(r2.x, 1.5, -(r1.x)), mad(r2.y, 1.5, -(r1.y)), mad(r2.z, 1.5, -(r1.z)));
				// mad r1.xyz, r2.xyzx, l(0.400000, 0.400000, 0.400000, 0.000000), r1.xyzx
				r1.xyz = float3(mad(r2.x, 0.4, r1.x), mad(r2.y, 0.4, r1.y), mad(r2.z, 0.4, r1.z));
				// mul r0.yz, r0.zzwz, cb0[8].xxxx
				r0.yz = float2(r0.z * _Params3.x, r0.w * _Params3.x);
				// frc r0.yz, r0.yyzy
				r0.yz = float2(frac(r0.y), frac(r0.z));
				// add r0.yz, r0.yyzy, l(0.000000, -0.500000, -0.500000, 0.000000)
				r0.yz = float2(r0.y + -0.5, r0.z + -0.5);
				// dp2 r0.y, r0.yzyy, r0.yzyy
				r0.y = r0.y * r0.y + r0.z * r0.z;
				// sqrt r0.y, r0.y
				r0.y = sqrt(r0.y);
				// mul r0.z, cb0[8].z, l(0.500000)
				r0.z = _Params3.z * 0.5;
				// lt r0.z, r0.y, r0.z
				r0.z = (r0.y < r0.z) ? -1.0 : 0.0;
				// mad r0.w, -r0.y, l(3.000000), l(1.000000)
				r0.w = mad(-(r0.y), 3.0, 1.0);
				// max r0.w, r0.w, l(0.000000)
				r0.w = max(r0.w, 0.0);
				// mul r0.w, r0.w, r0.w
				r0.w = r0.w * r0.w;
				// mul r2.xyz, r0.wwww, cb0[5].xyzx
				r2.xyz = float3(r0.w * _ColorC.x, r0.w * _ColorC.y, r0.w * _ColorC.z);
				// mad r2.xyz, r2.xyzx, cb0[8].zzzz, r1.xyzx
				r2.xyz = float3(mad(r2.x, _Params3.z, r1.x), mad(r2.y, _Params3.z, r1.y), mad(r2.z, _Params3.z, r1.z));
				// lt r0.y, r0.y, l(0.400000)
				r0.y = (r0.y < 0.4) ? -1.0 : 0.0;
				// mul r3.xyz, r1.xyzx, l(0.920000, 0.920000, 0.920000, 0.000000)
				r3.xyz = float3(r1.x * 0.92, r1.y * 0.92, r1.z * 0.92);
				// movc r1.xyz, r0.yyyy, r3.xyzx, r1.xyzx
				r1.xyz = float3(r0.y != 0.0 ? r3.x : r1.x, r0.y != 0.0 ? r3.y : r1.y, r0.y != 0.0 ? r3.z : r1.z);
				// movc r0.yzw, r0.zzzz, r2.xxyz, r1.xxyz
				r0.yzw = float3(r0.z != 0.0 ? r2.x : r1.x, r0.z != 0.0 ? r2.y : r1.y, r0.z != 0.0 ? r2.z : r1.z);
				// dp3 r1.x, r0.yzwy, l(0.212600, 0.715200, 0.072200, 0.000000)
				r1.x = r0.y * 0.2126 + r0.z * 0.7152 + r0.w * 0.0722;
				// add r0.yzw, r0.yyzw, -r1.xxxx
				r0.yzw = float3(r0.y + -(r1.x), r0.z + -(r1.x), r0.w + -(r1.x));
				// mad r0.yzw, cb0[10].zzzz, r0.yyzw, r1.xxxx
				r0.yzw = float3(mad(_Saturation, r0.y, r1.x), mad(_Saturation, r0.z, r1.x), mad(_Saturation, r0.w, r1.x));
				// add r0.yzw, r0.yyzw, l(0.000000, -0.500000, -0.500000, -0.500000)
				r0.yzw = float3(r0.y + -0.5, r0.z + -0.5, r0.w + -0.5);
				// mad_sat r0.yzw, r0.yyzw, cb0[10].xxxx, l(0.000000, 0.500000, 0.500000, 0.500000)
				r0.yzw = float3(saturate(mad(r0.y, _Contrast, 0.5)), saturate(mad(r0.z, _Contrast, 0.5)), saturate(mad(r0.w, _Contrast, 0.5)));
				// mul r0.yzw, r0.yyzw, cb0[3].xxyz
				r0.yzw = float3(r0.y * _Color.x, r0.z * _Color.y, r0.w * _Color.z);
				// mul r0.yzw, r0.yyzw, cb0[10].yyyy
				r0.yzw = float3(r0.y * _Emission, r0.z * _Emission, r0.w * _Emission);
				// lt r1.x, l(0.500000), cb0[11].y
				r1.x = (0.5 < _ToggleDither) ? -1.0 : 0.0;
				// mul r1.yz, v1.xxyx, cb1[6].xxyx
				r1.yz = float2(v1.x * _ScreenParams.x, v1.y * _ScreenParams.y);
				// mul r1.yz, r1.yyzy, l(0.000000, 127.099998, 311.700012, 0.000000)
				r1.yz = float2(r1.y * 127.1, r1.z * 311.7);
				// frc r1.yz, r1.yyzy
				r1.yz = float2(frac(r1.y), frac(r1.z));
				// add r2.xy, r1.yzyy, l(34.230000, 34.230000, 0.000000, 0.000000)
				r2.xy = float2(r1.y + 34.23, r1.z + 34.23);
				// dp2 r1.w, r1.yzyy, r2.xyxx
				r1.w = r1.y * r2.x + r1.z * r2.y;
				// add r1.yz, r1.wwww, r1.yyzy
				r1.yz = float2(r1.w + r1.y, r1.w + r1.z);
				// mul r1.y, r1.z, r1.y
				r1.y = r1.z * r1.y;
				// frc r1.y, r1.y
				r1.y = frac(r1.y);
				// add r1.y, r1.y, l(-0.500000)
				r1.y = r1.y + -0.5;
				// mad r1.yzw, r1.yyyy, l(0.000000, 0.003922, 0.003922, 0.003922), r0.yyzw
				r1.yzw = float3(mad(r1.y, 0.003922, r0.y), mad(r1.y, 0.003922, r0.z), mad(r1.y, 0.003922, r0.w));
				// movc r0.yzw, r1.xxxx, r1.yyzw, r0.yyzw
				r0.yzw = float3(r1.x != 0.0 ? r1.y : r0.y, r1.x != 0.0 ? r1.z : r0.z, r1.x != 0.0 ? r1.w : r0.w);
				// mul o0.xyz, r0.yzwy, v2.xyzx
				o0.xyz = float3(r0.y * v2.x, r0.z * v2.y, r0.w * v2.z);
				// mov o0.w, r0.x
				o0.w = r0.x;
				return o0;
			}
			#endif

			ENDCG
		}
	}
