<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Library, not exe: this project replaced the old ShaderRipper library
         (src/ShaderRipper.Old, unloaded from the solution).  Command-line front
         ends live in ShaderRipper.Application, which references this. -->
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ShaderRipper</AssemblyName>
    <RootNamespace>ShaderRipper</RootNamespace>
    <Version>1.2.1</Version>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Localized interface strings live here (Localization/Strings.*.resx):
         the library owns every message, the exe only formats them.  No language
         filter, so each .resx becomes a satellite assembly in the output.

         InvariantGlobalization is deliberately NOT set: it disables every
         non-invariant culture, so the "zh" language option could not resolve
         zh-Hans and the satellite assembly would never be found. -->
    <ShaderNativeRid Condition="'$(ShaderNativeRid)' == ''">$(RuntimeIdentifier)</ShaderNativeRid>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ShaderRipper.Application" />
    <!-- The desktop front end reads the same log and progress counter the console
         uses; it is not part of the solution and is not shipped here. -->
    <InternalsVisibleTo Include="ShaderRipper.Gui" />
  </ItemGroup>
  <ItemGroup>
    <!-- Runtime only: the lexer/parser under Grammar/ are generated ahead of
         time and checked in (src/ShaderRipper/Grammar/*.g4 plus their four
         outputs each), so building this project needs no JVM.  Regenerate them
         with scripts/gen_grammar.py after editing a grammar. -->
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <!-- LZ4: Unity's shader blobs are LZ4 block-compressed. -->
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <!-- Unity's typetree database and endian primitives, needed to read a
         SerializedFile without a per-version hand-written schema. -->
    <PackageReference Include="AssetRipper.Tpk" Version="2.0.0" />
    <PackageReference Include="AssetRipper.IO.Endian" Version="2.1.0" />
    <PackageReference Include="AssetRipper.Primitives" Version="3.2.0" />
    <PackageReference Include="LZMA-SDK" Version="22.1.1" />
    <!-- d3d9 token streams and the DXBC->DXIL fallback. -->
    <PackageReference Include="DXDecompiler-ly" Version="0.0.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Every data file the library reads at runtime, embedded so the binary is
         self-contained.  They live under Resources/ (not next to the code) and
         are unpacked to %TEMP%\ShaderRipper\embed on first use, where
         Paths.ExtractEmbedded looks for "data/<name>".  The manifest name keeps
         the "data/" prefix so the existing lookups do not have to change. -->
    <EmbeddedResource Include="Resources/data/*.tpk" LogicalName="ShaderRipper.Embed.data/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources/data/*.txt" LogicalName="ShaderRipper.Embed.data/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources/data/*.json" LogicalName="ShaderRipper.Embed.data/%(Filename)%(Extension)" />
    <!-- Native libraries are not data: NativeLibLoader extracts them by their
         own manifest names, so they keep the Native. prefix and stay put.

         Conditional on the target platform: a single-file publish embeds what is
         in this ItemGroup, and shipping a Linux binary that carries only Windows
         DLLs (or the reverse) is a publish that cannot decompile anything.  With
         no RuntimeIdentifier every library is embedded, which is what a plain
         `dotnet run` needs to pick whichever one the host can load. -->
    <EmbeddedResource Include="NativeLibs/D3Dcompiler_47.dll" LogicalName="ShaderRipper.Native.%(Filename)%(Extension)" />
    <EmbeddedResource Include="NativeLibs/win-x64/*.dll" LogicalName="ShaderRipper.Native.%(Filename)%(Extension)"
                      Condition="'$(ShaderNativeRid)' == 'win-x64' Or '$(ShaderNativeRid)' == ''" />
    <EmbeddedResource Include="NativeLibs/linux-x64/*.so" LogicalName="ShaderRipper.Native.%(Filename)%(Extension)"
                      Condition="'$(ShaderNativeRid)' == 'linux-x64' Or '$(ShaderNativeRid)' == ''" />
  </ItemGroup>
</Project>
