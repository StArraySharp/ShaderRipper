<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ShaderRipper</AssemblyName>
    <RootNamespace>ShaderRipper</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- AOT 发布：dotnet publish -c Release -r win-x64 -p:PublishAot=true -->
    <!-- Linux 同理 -r linux-x64（AOT 不能跨 OS，linux 包须在 Linux 上发布；非 AOT self-contained 可交叉） -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- 双语文案编译进 StringsData.cs（由 Localization/strings.*.txt 生成），
         不用 resx 卫星程序集（NativeAOT 不支持）；改文案后重跑生成脚本即可 -->
  </ItemGroup>
  <ItemGroup>
    <!-- 资源随构建复制到输出目录：exe 单独拷走也能找到 schema/ 与 data/（见 Paths.cs）。
         globals_names 是针对特定游戏的修复表，刻意不进发布包；仓库内运行时 Paths 仍会找到它。 -->
    <None Update="data/**/*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="data/*.tpk" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="data/globals_names/**" />
    <None Update="schema/*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- d3dcompiler 仅 Windows、仅 SM4/5 DXBC 需要；内嵌进主程序集运行时解压（NativeLibLoader） -->
    <EmbeddedResource Include="NativeLibs/D3Dcompiler_47.dll"
                      LogicalName="ShaderRipper.Native.D3Dcompiler_47.dll" />
    <!-- 反汇编统一走 DXC（dxcompiler）：按 RID 复制对应原生库到输出目录 -->
    <None Update="NativeLibs/win-x64/dxcompiler.dll" CopyToOutputDirectory="PreserveNewest"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == ''" />
    <None Update="NativeLibs/win-x64/dxil.dll" CopyToOutputDirectory="PreserveNewest"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == ''" />
    <None Update="NativeLibs/linux-x64/libdxcompiler.so" CopyToOutputDirectory="PreserveNewest"
          Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
    <None Update="NativeLibs/linux-x64/libdxil.so" CopyToOutputDirectory="PreserveNewest"
          Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AssetRipper.Tpk" Version="2.0.0" />
    <PackageReference Include="AssetRipper.IO.Endian" Version="2.1.0" />
    <PackageReference Include="AssetRipper.Primitives" Version="3.2.0" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
  </ItemGroup>
</Project>
