<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ShaderRipper</AssemblyName>
    <RootNamespace>ShaderRipper</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- AOT 发布：dotnet publish -c Release -r win-x64 -p:PublishAot=true -->
    <!-- Linux 同理 -r linux-x64（AOT 不能跨 OS，linux 包须在 Linux 上发布；非 AOT self-contained 可交叉） -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- 双语文案编译进 StringsData.cs（由 Localization/strings.*.txt 生成），
         不用 resx 卫星程序集（NativeAOT 不支持）；改文案后重跑生成脚本即可 -->
  </ItemGroup>
  <ItemGroup>
    <!-- 运行所需资源全部嵌入主程序集（发布产物只剩单个可执行）：
         运行时由 Paths 解压到 %TEMP%\ShaderRipper\embed\，磁盘文件仍优先（开发仓库直读）。
         globals_names 是针对特定游戏的修复表，刻意不嵌入。 -->
    <EmbeddedResource Include="schema/*.json" LogicalName="ShaderRipper.Embed.%(Identity)" />
    <EmbeddedResource Include="data/*.txt" LogicalName="ShaderRipper.Embed.%(Identity)" />
    <EmbeddedResource Include="data/*.tpk" LogicalName="ShaderRipper.Embed.%(Identity)" />
    <EmbeddedResource Include="data/tmp_layouts/*.txt" LogicalName="ShaderRipper.Embed.%(Identity)" />
    <None Remove="data/globals_names/**" />
    <!-- 原生库按 RID 嵌入（d3dcompiler 仅 Windows）：运行时解压到 %TEMP%\ShaderRipper\native\ -->
    <EmbeddedResource Include="NativeLibs/D3Dcompiler_47.dll"
                      LogicalName="ShaderRipper.Native.D3Dcompiler_47.dll" />
    <EmbeddedResource Include="NativeLibs/win-x64/dxcompiler.dll"
                      LogicalName="ShaderRipper.Native.dxcompiler.dll"
                      Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == ''" />
    <EmbeddedResource Include="NativeLibs/win-x64/dxil.dll"
                      LogicalName="ShaderRipper.Native.dxil.dll"
                      Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == ''" />
    <EmbeddedResource Include="NativeLibs/linux-x64/libdxcompiler.so"
                      LogicalName="ShaderRipper.Native.libdxcompiler.so"
                      Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
    <EmbeddedResource Include="NativeLibs/linux-x64/libdxil.so"
                      LogicalName="ShaderRipper.Native.libdxil.so"
                      Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AssetRipper.Tpk" Version="2.0.0" />
    <PackageReference Include="AssetRipper.IO.Endian" Version="2.1.0" />
    <PackageReference Include="AssetRipper.Primitives" Version="3.2.0" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <!-- 纯托管 DXBC(SM4/5) 反汇编器：Linux 上 d3dcompiler 缺席时的后备（AssetRipperPatcher 同款） -->
    <PackageReference Include="DXDecompiler-ly" Version="0.0.1" />
  </ItemGroup>
</Project>
