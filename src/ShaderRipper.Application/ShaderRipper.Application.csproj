<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ShaderRipper.Application</AssemblyName>
    <RootNamespace>ShaderRipper</RootNamespace>
    <Version>1.2.2</Version>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- No language filter and no InvariantGlobalization: the localized strings
         ship in the ShaderRipper library (Localization/Strings.*.resx), their
         satellite assemblies must reach this exe's output directory, and the
         runtime must be able to resolve the cultures they are keyed by. -->
    <!-- Server GC.  An export translates shaders in parallel (see the jobs
         option) and every translation allocates disassembly text, an AST and
         HLSL; with the default workstation GC those allocations serialise on a
         single stop-the-world heap, which measured as 8 workers spending 2.5x the
         CPU of one worker for almost no wall-clock gain.  Server GC gives each
         core its own heap. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- The single library the tool is built on: src/ShaderRipper
         (AssemblyName ShaderRipper).  The old hand-written implementation,
         src/ShaderRipper.Old, is kept on disk for reference only and is not
         referenced by anything.

         No `AdditionalProperties` here.  Passing one made the library's global
         properties differ from every other project's, so MSBuild built it twice under
         two configurations into one obj/ directory and the parallel solution build
         failed with CS2012 ("the file is being used by another process").  The library
         picks its native set from its own RuntimeIdentifier instead. -->
    <ProjectReference Include="..\ShaderRipper\ShaderRipper.csproj" />
  </ItemGroup>
</Project>
